# ==========================================
# MERN Stack Project .gitignore
# ==========================================

# 1. Dependency Directories
node_modules/
/node_modules
jspm_packages/
.pnp
.pnp.js

# 2. Environment Variables & Secrets (CRITICAL)
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
*.env
.passport.js

# 3. Production Build Directories
dist/
build/
out/
.next/
.parcel-cache

# 4. Logs and Caches
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pids
*.pid
*.seed
*.pid.lock
.npm
.eslintcache
.turbo/

# 5. Testing & Coverage
coverage/
.nyc_output
*.test.js.snap

# 6. IDEs and Editors Configuration
.vscode/
!.vscode/extensions.json
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.swp
*.swo

# 7. Operating System Files
.DS_Store
.DS_Store?
._*
Thumbs.db
desktop.ini

# 8. Local/Temporary Uploads
# (Ignores local media uploads so they don't bloat your repo)
server/uploads/
server/thumbnails/
backend/uploads/
